# 复制成 .env（不要提交），或直接把变量设到系统环境
# 只填你要用的那一个即可；config.json 里 providers 的顺序就是优先级

# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 通义千问 DashScope（https://bailian.console.aliyun.com）
DASHSCOPE_API_KEY=

# 本地 Ollama 默认不校验 key，留空也行
OLLAMA_API_KEY=

# HuggingFace 在国内直连不通，走镜像
HF_ENDPOINT=https://hf-mirror.com
